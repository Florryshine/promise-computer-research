NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Pairgate VTU provider — keep the key server-side; never use NEXT_PUBLIC_.
PAIRGATE_API_KEY=your_pairgate_api_key
PAIRGATE_BASE_URL=https://pairgate.com/api/v1
# Set explicitly. NOTE: if this variable is missing the app runs LIVE (the code default is false). true = Pairgate /test routes only.
PAIRGATE_TEST_MODE=true
# Configure this same secret in Pairgate's webhook dashboard and Vercel.
PAIRGATE_WEBHOOK_SECRET=your_pairgate_webhook_secret
# Pairgate webhook URL: https://<your-production-domain>/api/pairgate/webhook
