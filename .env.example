NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NIFEX_API_KEY=your_nifex_api_token
NIFEX_BASE_URL=https://nifexdataapp.com.ng/api/
# JSON maps are optional when the app already stores numeric Nifex IDs.
# Add exact IDs shown by Nifex; do not guess provider IDs.
NIFEX_NETWORK_IDS={}
# Map app plan labels/codes to numeric plan IDs supplied by Nifex.
NIFEX_DATA_PLAN_IDS={}
NIFEX_CABLE_IDS={}
NIFEX_CABLE_PLAN_IDS={}
NIFEX_ELECTRICITY_IDS={}
NIFEX_METER_TYPE_IDS={}

# Map exact provider labels/IDs from the Nifex dashboard; never guess IDs.
NIFEX_EXAM_PROVIDER_IDS={}
NIFEX_DATAPIN_PLAN_IDS={}
